# ---- Discord --------------------------------------------------------------------------
DISCORD_TOKEN=
# Comma-separated user IDs allowed to use the bot (Developer Mode > right-click user > Copy User ID).
ALLOWED_USER_IDS=
# Channel that receives incident alerts, e.g. #homelab-alerts (right-click channel > Copy Channel ID).
ALERT_CHANNEL_ID=
# Optional: your server ID. Syncs slash commands to that server only.
GUILD_ID=

# ---- Webhook: POST /webhook/alert (Uptime Kuma, Alertmanager, Grafana) ------------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Host networking: 0.0.0.0 exposes it to your LAN. Use this host's LAN IP to narrow it.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ---- Docker ---------------------------------------------------------------------------
# Group id owning the socket, used by the proxy: stat -c %g /var/run/docker.sock
DOCKER_GID=
# One alert per service per window; the Acknowledge button silences for 1 h.
ALERT_COOLDOWN_S=300
# /lockdown stops these (external ingress only; never list the bot or the proxy).
LOCKDOWN_CONTAINERS=cloudflared,nginx-proxy-manager,wireguard

# ---- Wake-on-LAN ----------------------------------------------------------------------
# "port" is the TCP port probed to detect "online" (22 ssh, 445 smb, 3389 rdp...). Default 22.
WOL_HOSTS='{"nas": {"mac": "AA:BB:CC:DD:EE:01", "ip": "192.168.1.10", "port": 445}, "ai-rig": {"mac": "AA:BB:CC:DD:EE:02", "ip": "192.168.1.20", "port": 22}, "gaming-pc": {"mac": "AA:BB:CC:DD:EE:03", "ip": "192.168.1.30", "port": 3389}}'
WOL_BROADCAST=255.255.255.255

# ---- UPS via NUT (leave NUT_HOST empty to disable) ------------------------------------
NUT_HOST=
NUT_PORT=3493
NUT_UPS=ups

LOG_LEVEL=INFO
